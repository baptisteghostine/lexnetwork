{
  "name": "Rolo",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  // --ignore-scripts skips better-sqlite3's node-gyp step; the package ships
  // a prebuilt linux-x64 binary, so nothing needs compiling here.
  "postCreateCommand": "npm install --ignore-scripts && npm run db:migrate && npm run seed",
  // Starts the dev server on attach so the forwarded port is live immediately.
  "postAttachCommand": "npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Rolo",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
